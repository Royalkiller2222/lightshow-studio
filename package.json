{
  "name": "lightshow-studio",
  "version": "0.6.0",
  "description": "3D lightshow designer and DMX previsualizer",
  "author": "Lightshow Studio",
  "homepage": "https://github.com/Royalkiller2222/lightshow-studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/artnet-roundtrip.js",
    "icons": "electron scripts/make-icons.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lightshow.studio",
    "productName": "Lightshow Studio",
    "copyright": "Copyright © 2026 Lightshow Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "dmx-io.js",
      "src/**/*",
      "package.json"
    ],
    "onNodeModuleFile": "scripts/builder-include.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lightshow Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "LightshowStudio-Setup-${version}.${ext}"
    }
  }
}
